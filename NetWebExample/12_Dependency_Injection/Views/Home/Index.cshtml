@{
    ViewData["Title"] = "Home Page";
}


    <h1 class="display-5 text-center mb-4">Welcome</h1>
    <p class="text-center"> Sayfayı bir kaç kez yenileyin hangi değerlerin değiştiğini izleyin</p>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-warning">Transient</div>
                <div class="card-body">
                    <p>1.istek:<strong>@ViewBag.Transient1</strong></p>
                    <p>2.istek:<strong>@ViewBag.Transient2</strong></p>
                    <small>Her istemde yeni nesne iki değer aynı sayfada bile farklı</small>
                </div>
            </div>
        </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header bg-warning">Scoped</div>
            <div class="card-body">
                <p>1.istek:<strong>@ViewBag.Scoped1</strong></p>
                <p>2.istek:<strong>@ViewBag.Scoped2</strong></p>
                <small>Aynı Http isteğinde aynı nesne iki değer aynı sayfa. Sayfa yenilenince istekden gelen değer değişir.</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header bg-warning">Singleton</div>
            <div class="card-body">
                <p>1.istek:<strong>@ViewBag.Singleton1</strong></p>
                <p>2.istek:<strong>@ViewBag.Singleton2</strong></p>
                <small>Uygulama boyunca aynı değer değişmez</small>
            </div>
        </div>
    </div>
    </div>
