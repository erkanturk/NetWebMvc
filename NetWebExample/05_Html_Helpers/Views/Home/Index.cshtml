@model Users
@{
    ViewData["Title"] = "Home Page";
}

<h1>Html Helper Örneği</h1>
<p>
    Helpers
</p>
@using(Html.BeginForm("Submit","Home",FormMethod.Post))
{
    <div class="mb-3">
        @Html.LabelFor(m=>m.Name) @*<label for=name>Ad</label>*@
        @Html.TextBoxFor(m=>m.Name,new {@class="form-control"}) @*<input type="text" name="Name">*@
        @Html.ValidationMessageFor(m=>m.Name,null,new{@class="text-danger"})
    </div>
    <div class="mb-3">
        @Html.LabelFor(m=>m.Age) @*<label for=name>Ad</label>*@
        @Html.TextBoxFor(m=>m.Age,new {@class="form-control",type="number"}) @*<input type="text" name="Name">*@
        @Html.ValidationMessageFor(m=>m.Age,null,new{@class="text-danger"})
    </div>
    <div class="mb-3">
        @Html.RadioButtonFor(m=>m.Gender,"Erkek") Erkek 
        @Html.RadioButtonFor(m=>m.Gender,"Kadın") Kadın
        @Html.ValidationMessageFor(m=>m.Gender,null,new{@class="text-danger"})
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Country) @*<label for=name>Ad</label>*@
        @Html.DropDownListFor(m => m.Country,Model.CountryList,"Ülke Seçin" ,new { @class = "form-select" }) 
        @Html.ValidationMessageFor(m => m.Country, null, new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-primary">Gönder</button>

}
@Html.ValidationSummary(false,"",new{@class="text-danger mt-3"})
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}