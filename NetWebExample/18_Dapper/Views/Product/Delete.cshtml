@model Product
@{
    ViewData["Title"] = "Ürün Sil";
}

<h1>Ürün Sil</h1>
<div class="alert alert-warning">Bu ürünü silmek istediğinize emin misiniz ?</div>
<dl class="row">
    <dt class="col-sm-2">Ad</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Fiyat</dt>
    <dd class="col-sm-10">@Model.Price.ToString("C")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ProductId" name="id" />
    <button type="submit" class="btn btn-danger">Evet Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts {
    <script>
       
            alert(`{@Model.Name}` + " Bu ürünü silmek istediğinize emin misiniz ? ")
    </script>
    
}