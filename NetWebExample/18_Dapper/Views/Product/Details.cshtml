@model Product
@{
    ViewData["Title"] = "Ürün Detay";
}
<h1>Ürün Detay</h1>
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.ProductId</dd>
    <dt class="col-sm-2">Ad</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Fiyat</dt>
    <dd class="col-sm-10">@Model.Price.ToString("C")</dd>
    <dt class="col-sm-2">Kategori Id</dt>
    <dd class="col-sm-10">@Model.CategoryId</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-sm btn-warning">Düzenle</a>
<a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-sm btn-danger">Sil</a>