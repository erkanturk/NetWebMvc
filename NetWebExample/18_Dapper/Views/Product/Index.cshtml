@model IEnumerable<Product>
@{
    ViewData["Title"] = "Ürünler";
}
<h1>Ürünler</h1>
<p>
    <a asp-action="Create" class="btn btn-secondary">Yeni Ürün</a>
    <a asp-action="CreateCategory" class="btn btn-secondary">Yeni Kategory</a>
</p>
<table class="table-striped">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Fiyat</th>
            <th>Kategori</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary">Detay</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>